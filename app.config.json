{
  "$schema": "./schemas/app-config.schema.json",
  "name": "Face Redactor",
  "nameJa": "顔ぼかし",
  "slug": "face-redactor",
  "version": "1.0.1",
  "description": "Detect and redact faces locally in the browser with automatic detection and manual masks.",
  "descriptionJa": "顔を自動検出し、モザイク・ぼかし・塗りつぶしなどで匿名化する完全ローカル処理ツールです。",
  "defaultLanguage": "auto",
  "repository": {
    "owner": "ttomohisa",
    "name": "htmlapps-face-redactor"
  },
  "build": {
    "output": "dist/index.html",
    "blockRuntimeNetwork": true,
    "selfExtract": {
      "enabled": true,
      "output": "dist/index.self-extract.html"
    }
  }
}
